# Copy to .env.local and fill in your own keys: cp .env.example .env.local
# Each platform is optional. A tab with missing keys shows "Not configured"
# and the other two keep working. See docs/SETUP.md for where each value lives.
#
# SECRET = server only. Never prefix with NEXT_PUBLIC_, never commit.
# PUBLIC = safe in the browser (the NEXT_PUBLIC_ prefix exposes it).

# ---------- Demo controls ----------
# SECRET. A password you make up (openssl rand -hex 24). Open the app with
# ?owner=<this value> to send the email fallback to DEMO_EMAIL_TO.
# Without it, the email step is skipped.
DEMO_OWNER_TOKEN=change-me-to-a-long-random-string
# SECRET. Your inbox, for owner-mode email. With Resend's test sender
# (onboarding@resend.dev), this must be your Resend account's email.
DEMO_EMAIL_TO=you@example.com
# Max triggers per IP per vendor in 10 minutes. Owner mode is exempt.
DEMO_RATE_LIMIT=5

# ---------- Novu ----------
# SECRET. Dashboard > API Keys > Secret Key. Also used for HMAC hashes.
NOVU_SECRET_KEY=
# PUBLIC. Dashboard > API Keys > Application Identifier.
NEXT_PUBLIC_NOVU_APP_ID=
# PUBLIC. Identifier of the custom-code agent you create in Dashboard > Agents.
NEXT_PUBLIC_NOVU_AGENT_ID=parcelly-support
# Optional. EU region: https://eu.api.novu.co
NOVU_API_URL=https://api.novu.co

# ---------- Knock ----------
# SECRET. Developers > API keys > Secret key (Development environment).
KNOCK_API_KEY=
# SECRET. Developers > API keys > Signing key (for enhanced security).
KNOCK_SIGNING_KEY=
# PUBLIC. Developers > API keys > Public key.
NEXT_PUBLIC_KNOCK_PUBLIC_API_KEY=
# PUBLIC. Account settings > Channels and sources > your in-app feed channel ID.
NEXT_PUBLIC_KNOCK_FEED_CHANNEL_ID=
# The key of the workflow you create in Knock.
KNOCK_WORKFLOW_KEY=order-shipped

# ---------- Courier ----------
# SECRET. Settings > API Keys (workspace key).
COURIER_API_KEY=
# The journey's ID, a UUID shown in the journey editor's header.
# The journey name doesn't work here.
COURIER_JOURNEY_ID=

# ---------- AI (Novu's personalization step and support agent) ----------
# SECRET. Knock and Courier run their AI steps on their own credits instead.
OPENAI_API_KEY=
